+            var mirroredPhase = phase == 0 ? 0 : period-phase;
+            var currentTime = this.motionTime;
+
+            function latestMatch(matchPhase){
+                return matchPhase + (Math.floor((currentTime-matchPhase)/period)*period);
+            }
+
+            // A height occurs once on each half of the lift cycle. Rewind to
+            // the closest occurrence at or before now, using the saved echo
+            // rather than the lift's live position.
+            this.motionTime = Math.max(0,Math.max(
+                latestMatch(phase),
+                latestMatch(mirroredPhase)
+            ));
+            for (var i=0; i<this.movingSupports.length; i++){
+                this.movingSupports[i].update(this.motionTime);
+            }
