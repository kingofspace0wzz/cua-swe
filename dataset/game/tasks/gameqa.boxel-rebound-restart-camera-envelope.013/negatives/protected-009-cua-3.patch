+        this.restoreCheckpoint = function(frame, cameraX){
+            if (typeof cameraX == "number" && isFinite(cameraX)){
+                this.cameraProgress = cameraX;
+                this.x = -cameraX;
+            }
+            if (frame == null) return;
+            var support = this.getSupport(frame.id);
+            if (support == null) return;
+            this.motionTime = support.previousTimeAtY(frame.y,this.motionTime);
+            for (var i=0; i<this.movingSupports.length; i++){
+                this.movingSupports[i].update(this.motionTime);
+            }
+        };
         this.showGuide = function(frame){
             if (this.guideView != null && this.guideView.parent != null){
