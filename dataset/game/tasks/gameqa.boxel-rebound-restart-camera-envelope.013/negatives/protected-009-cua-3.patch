@@ -313,6 +326,23 @@
                 this.top = map.y+this.baseY+this.offsetY;
                 this.view.y = this.baseY+this.offsetY;
             };
+            this.previousTimeAtY = function(y,time){
+                var period = 2800;
+                var offset = Math.max(-60,Math.min(0,y-this.baseY));
+                var angle = Math.acos(Math.max(-1,Math.min(1,1+(offset/30))));
+                var phases = [
+                    angle/(Math.PI*2)*period,
+                    (Math.PI*2-angle)/(Math.PI*2)*period
+                ];
+                var cycleStart = time-(time%period);
+                var nearest = -Infinity;
+                for (var i=0; i<phases.length; i++){
+                    var candidate = cycleStart+phases[i];
+                    if (candidate > time) candidate -= period;
+                    if (candidate > nearest) nearest = candidate;
+                }
+                return Math.max(0,nearest);
+            };
         }
 	}
 }(window));
