+        this.restoreGuideFrame = function(frame){
+            if (frame == null) return false;
+            var support = this.getSupport(frame.id);
+            if (support == null || !Number.isFinite(frame.y)) return false;
+
+            // Recover the most recent matching lift phase from checkpoint geometry.
+            // The checkpoint remains independent of both the motion clock and camera.
+            var cycle = 2800;
+            var phase = Math.acos(Math.max(-1,Math.min(1,
+                1+((frame.y-support.baseY)/30)
+            )));
+            var phases = [phase,Math.PI*2-phase];
+            var cycleIndex = Math.floor(this.motionTime/cycle);
+            var restoredTime = -Infinity;
+            for (var c=cycleIndex; c>=Math.max(0,cycleIndex-1); c--){
+                for (var p=0; p<phases.length; p++){
+                    var candidate = c*cycle+(phases[p]/(Math.PI*2))*cycle;
+                    if (candidate <= this.motionTime+0.01 && candidate > restoredTime){
+                        restoredTime = candidate;
+                    }
+                }
+            }
+            if (!Number.isFinite(restoredTime)) return false;
+            this.motionTime = restoredTime;
+            for (var i=0; i<this.movingSupports.length; i++){
+                this.movingSupports[i].update(this.motionTime);
+            }
+            return true;
+        };
