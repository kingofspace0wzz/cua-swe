@@ -308,11 +317,27 @@
             this.view.x = this.left;
             this.view.y = this.baseY;
             this.update = function(time){
-                var phase = (time%2800)/2800*Math.PI*2;
+                var phase = (((time+this.timeOffset)%2800)+2800)%2800/2800*Math.PI*2;
                 this.offsetY = -30*(1-Math.cos(phase));
                 this.top = map.y+this.baseY+this.offsetY;
                 this.view.y = this.baseY+this.offsetY;
             };
+            this.timeOffset = 0;
+            this.restoreFrame = function(frameY,time){
+                var offset = Math.max(-60,Math.min(0,frameY-this.baseY));
+                var phase = Math.acos(Math.max(-1,Math.min(1,1+(offset/30))));
+                var currentPhase = (((time+this.timeOffset)%2800)+2800)%2800/2800*Math.PI*2;
+                var alternate = (Math.PI*2)-phase;
+                var phaseDistance = function(a,b){
+                    var distance = Math.abs(a-b)%(Math.PI*2);
+                    return Math.min(distance,(Math.PI*2)-distance);
+                };
+                if (phaseDistance(alternate,currentPhase) < phaseDistance(phase,currentPhase)){
+                    phase = alternate;
+                }
+                this.timeOffset = (phase/(Math.PI*2)*2800)-(((time%2800)+2800)%2800);
+                this.update(time);
+            };
         }
 	}
 }(window));
