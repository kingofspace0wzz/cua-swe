+  function intervalForLinear(valueStart, valueEnd, threshold, below) {
+    const startMatches = below ? valueStart < threshold : valueStart > threshold;
+    const endMatches = below ? valueEnd < threshold : valueEnd > threshold;
+    if (startMatches && endMatches) return {start: 0, end: 1};
+    if (!startMatches && !endMatches) return null;
+    const crossing = (threshold - valueStart) / (valueEnd - valueStart);
+    return startMatches
+      ? {start: 0, end: crossing}
+      : {start: crossing, end: 1};
+  }
+
+  function intersectIntervals(first, second) {
+    if (!first || !second) return null;
+    const start = Math.max(first.start, second.start);
+    const end = Math.min(first.end, second.end);
+    return start < end ? {start, end} : null;
+  }
+
+  function horizontalInterval(bird, pipeStart, pipeEnd) {
+    const leftWindow = intervalForLinear(
+      pipeStart + PIPE_WIDTH,
+      pipeEnd + PIPE_WIDTH,
+      bird.left,
+      false
+    );
+    const rightWindow = intervalForLinear(pipeStart, pipeEnd, bird.right, true);
+    return intersectIntervals(leftWindow, rightWindow);
+  }
