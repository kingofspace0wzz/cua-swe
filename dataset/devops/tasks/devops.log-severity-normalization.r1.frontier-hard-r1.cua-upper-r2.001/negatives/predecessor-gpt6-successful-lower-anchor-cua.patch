@@ -14,4 +14,16 @@ export function fromJson(record) {
   if (typeof body === 'string') {try {body=JSON.parse(body);} catch {body={};}}
   return fromText(body?.level);
 }
-export const severityAdapters = {otlp:fromOtel,json:fromJson};
+export function fromSyslog(record) {
+  const rawNumber = record.severityNumber;
+  const number = typeof rawNumber === 'number' ||
+    (typeof rawNumber === 'string' && rawNumber.trim() !== '')
+    ? Number(rawNumber) : NaN;
+  // Unlike OTel, syslog zero is a real severity: emergency.
+  if (Number.isInteger(number) && number >= 0 && number <= 7) {
+    return fromText(['FATAL','FATAL','FATAL','ERROR','WARN','INFO','INFO','DEBUG'][number]);
+  }
+  const text = String(record.severityText ?? '').trim().toUpperCase();
+  return fromText(['EMERG','EMERGENCY','ALERT'].includes(text) ? 'FATAL' : text);
+}
+export const severityAdapters = {otlp:fromOtel,json:fromJson,syslog:fromSyslog};
