@@ -1,7 +1,11 @@
 import {severityAdapters} from './severityAdapters.js';
 
 export function resolveSeverity(record, receiver) {
-  const format = receiver.source.format;
+  // Decode the delivered representation, not the pre-collector source.
+  // The syslog relay preserves PRI severity (0–7) inside its OTLP envelope.
+  const deliveredFormat = receiver.output?.format ?? receiver.source.format;
+  const format = receiver.source.format === 'syslog' && deliveredFormat === 'otlp'
+    ? 'syslog' : deliveredFormat;
   const decode = severityAdapters[format];
   return decode ? decode(record) : {number:0, band:'UNSPECIFIED'};
 }
diff --git a/src/pipeline/severityAdapters.js b/src/pipeline/severityAdapters.js
index cea909e7f5a8b53020db5a1c2f1d2d675c7a54d6..a04e22882e67468a4127a2921cdccc6a6ab93363 100644
--- a/src/pipeline/severityAdapters.js
