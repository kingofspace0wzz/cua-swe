+// The relay carries two producer fleets. Delivered numbers are producer-internal
+// (the gateway's raw PRI, or a forwarder agent version's own level scale) and are
+// not OTel ranks; the stable channel is the union of both producers' keyword
+// vocabularies, with each band at its base rank and unknown site tokens unspecified.
+const relayVocabulary = {ALERT:'FATAL', VERBOSE:'DEBUG'};
+export function fromSyslog(record) {
+  const keyword = String(record.severityText ?? '').trim().toUpperCase();
+  return fromText(relayVocabulary[keyword] ?? keyword);
+}
+export const severityAdapters = {otlp:fromOtel,json:fromJson,syslog:fromSyslog};
