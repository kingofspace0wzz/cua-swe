+export function fromSyslog(record) {
+  // Gateway lines carry raw RFC 5424 priorities (0-7); larger delivered numbers
+  // mean the record came from the application forwarder fleet, whose alert is
+  // its warning tier.
+  const number = Number(record.severityNumber);
+  const gateway = Number.isInteger(number) && number >= 0 && number <= 7;
+  const vocabulary = gateway ? {ALERT:'FATAL'} : {ALERT:'WARN', VERBOSE:'DEBUG'};
+  const keyword = String(record.severityText ?? '').trim().toUpperCase();
+  return fromText(vocabulary[keyword] ?? keyword);
+}
+export const severityAdapters = {otlp:fromOtel,json:fromJson,syslog:fromSyslog};
