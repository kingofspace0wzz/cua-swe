+// The forwarder fleet's alert lines are its warning tier; relay numbers are
+// producer-internal scales, so decode the delivered keywords.
+const relayVocabulary = {ALERT:'WARN', VERBOSE:'DEBUG'};
+export function fromSyslog(record) {
+  const keyword = String(record.severityText ?? '').trim().toUpperCase();
+  return fromText(relayVocabulary[keyword] ?? keyword);
+}
