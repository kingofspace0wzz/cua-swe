+// The relay forwards two producer fleets and preserves each producer's own
+// severities. Delivered numbers are producer-internal scales (the gateway's raw
+// syslog PRI, each forwarder agent version's level codes), never OTel ranks, and
+// keywords resolve per producer: the forwarder fleet's "alert" is its warning
+// tier (between error and info on both agents' own scales), while the gateway
+// daemon's "alert" is RFC 5424 severity 1. Unknown site tokens stay unspecified.
+export function fromSyslog(record) {
+  const forwarded = /\bagent\/[^\s:]+: level=/.test(String(record.body ?? ''));
+  const vocabulary = forwarded ? {ALERT:'WARN', VERBOSE:'DEBUG'} : {ALERT:'FATAL'};
+  const keyword = String(record.severityText ?? '').trim().toUpperCase();
+  return fromText(vocabulary[keyword] ?? keyword);
+}
+export const severityAdapters = {otlp:fromOtel,json:fromJson,syslog:fromSyslog};
