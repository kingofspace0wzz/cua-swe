@@ -0,0 +1,31 @@
+// Channel self-check calibration. Every provisioned endpoint opens a session
+// epoch by pulsing its check register with signed lines and then settling it
+// with one unsigned line that carries the endpoint's own resulting register
+// value. Comparing that settle against the accumulated pulses binds the
+// endpoint's currently active update convention before any of its ordinary
+// traffic is applied; a reprovisioned endpoint re-runs the check in the epoch
+// that activates the change, so bindings never outlive their epoch.
+const near = (a, b) => Math.abs(a - b) <= 1e-9 + 1e-9 * Math.abs(b);
+export const isSignedToken = token => /^[+-]/.test(String(token ?? ''));
+export function createCalibrator() {
+  const bound = new Map(), pulses = new Map();
+  return {
+    mode(source) { return bound.get(source) ?? null; },
+    observe(source, token, value) {
+      if (bound.has(source)) return bound.get(source);
+      if (isSignedToken(token)) {
+        pulses.set(source, [...(pulses.get(source) ?? []), value]);
+        return null;
+      }
+      const seen = pulses.get(source) ?? [];
+      if (!seen.length) return null;
+      const sum = seen.reduce((total, pulse) => total + pulse, 0);
+      const mode = near(value, sum) && !near(value, seen[seen.length - 1])
+        ? 'signed-delta'
+        : 'absolute-reading';
+      bound.set(source, mode);
+      pulses.delete(source);
+      return mode;
+    },
+  };
+}
