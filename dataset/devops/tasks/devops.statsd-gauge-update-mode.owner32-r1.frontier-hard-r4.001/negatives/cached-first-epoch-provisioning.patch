+export const channelConventions = {
+  'statsd v0.9.0 gateway · event-driven gauge updates': 'signed-delta',
+  'site sweep publisher · reports every reading each sweep': 'absolute-reading',
+  'shift census recorder · re-reports the whole occupancy register every shift': 'absolute-reading',
+  'shift log recorder · retransmits the full level register every shift': 'absolute-reading',
+};
+export function mapChannelModes(producers) {
+  return Object.fromEntries(producers.map(entry => [entry.id, channelConventions[entry.channel] ?? 'absolute-reading']));
+}
