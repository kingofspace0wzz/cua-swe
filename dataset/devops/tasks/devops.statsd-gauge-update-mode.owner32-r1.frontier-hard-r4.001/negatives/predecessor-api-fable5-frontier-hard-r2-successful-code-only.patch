diff --git a/src/fleet.mjs b/src/fleet.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0c386324d2e7f2b72aebf17833c690ea46320451
--- /dev/null
+++ b/src/fleet.mjs
@@ -0,0 +1,35 @@
+// Fleet inventory helpers: map a datagram source to its provisioned producer
+// and derive the endpoint's published gauge convention.
+//   'delta'    -> statsd delta-capable relay: a lexical leading sign is a
+//                 relative update; negative absolutes arrive as an unsigned
+//                 zero followed by the negative delta.
+//   'absolute' -> snapshot-style publisher: every line is the reading itself,
+//                 possibly formatted with an explicit leading sign.
+const norm = value => String(value ?? '').trim().toLowerCase();
+export function classifyConvention(text) {
+  const c = norm(text);
+  if (!c) return null;
+  const delta = /delta|relative|incremental|cumulative|offset/.test(c);
+  const absolute = /snapshot|absolute|direct|verbatim|literal|reading|level|as-is/.test(c);
+  if (delta && !absolute) return 'delta';
+  if (absolute && !delta) return 'absolute';
+  return null;
+}
+export function findProducer(producers, source) {
+  const s = norm(source);
+  if (!s || !Array.isArray(producers)) return null;
+  for (const producer of producers) {
+    const fields = [producer?.endpoint, producer?.label, producer?.address, producer?.source, producer?.id]
+      .map(norm).filter(Boolean);
+    if (fields.some(field => field === s || field.includes(s) || s.includes(field))) return producer;
+  }
+  return null;
+}
+export function resolveUpdateMode(producers, source) {
+  const producer = findProducer(producers, source);
+  if (!producer) return null;
+  return classifyConvention(producer.channel)
+    ?? classifyConvention(producer.mode)
+    ?? classifyConvention(producer.label)
+    ?? classifyConvention(producer.endpoint);
+}
