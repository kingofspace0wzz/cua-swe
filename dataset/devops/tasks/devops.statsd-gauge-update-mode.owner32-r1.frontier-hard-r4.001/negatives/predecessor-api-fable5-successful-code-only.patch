+// A lexical leading sign on the wire token marks a relative update, but only
+// endpoints provisioned as delta-capable relays publish that way; snapshot
+// style publishers report absolute readings and may sign them explicitly.
+export function isSignedToken(token) {
+  return typeof token === 'string' && (token[0] === '+' || token[0] === '-');
