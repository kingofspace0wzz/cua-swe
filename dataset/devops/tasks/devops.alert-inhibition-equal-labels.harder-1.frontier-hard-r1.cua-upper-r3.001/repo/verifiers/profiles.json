{
  "visible": {
    "label": "Platform incident inhibition",
    "equalDimensions": [
      "environment",
      "cluster"
    ],
    "dimensions": [
      {
        "name": "cluster",
        "role": "suppression scope",
        "epoch": "M126",
        "note": "Compute cell that hosts the workload, recorded by the scheduler. Cell labels are stamped under migration epoch M126 of the cell consolidation program; the scope stamping runbook records that epoch's stamping state."
      },
      {
        "name": "environment",
        "role": "correlation context",
        "epoch": "M112",
        "note": "Delivery ring recorded by the deploy pipeline. Ring labels are stamped under migration epoch M112; the scope stamping runbook records that epoch's stamping state."
      }
    ],
    "advisories": [
      "Scope labels are stamped under numbered migration epochs. Alerts opened under an epoch that has not finished stamping may legitimately omit that label, and existing suppression between two such alerts is expected and must keep working.",
      "The scope stamping runbook page rendered in the stamping runbook panel is the operator authority for every epoch's stamping state. Consult it before changing rule eligibility.",
      "The incident timeline is deterministic: the initial batch, arriving alerts, a partial resolution, then a replay of the initial batch."
    ],
    "routes": [
      {
        "name": "page-oncall",
        "description": "Pages the on-call rotation for every firing alert.",
        "delivery": "firing-only"
      },
      {
        "name": "incident-archive",
        "description": "Archives every active alert for incident review, regardless of suppression.",
        "delivery": "all-active"
      }
    ],
    "sourceClass": "NodeUnavailable",
    "targetClass": "all active alerts",
    "alerts": [
      {
        "id": "v-node-west",
