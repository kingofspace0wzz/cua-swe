 const refresh = async () => store.set({ snapshot: await samplerClient.snapshot() });
 
+// Keep the collector decision window aligned with the receiver service
+// levels the collector reports: it must span the whole span-delivery
+// envelope (so late error/slow spans arrive before the decision is cached)
+// while staying within the tail-decision SLO budget. When the durable
+// configuration already satisfies both levels this is a no-op.
+async function alignDecisionWindow(plan) {
+  const snapshot = store.get().snapshot;
+  const diagnostics = snapshot && snapshot.diagnostics;
+  if (!diagnostics) return;
+  const envelope = Number(diagnostics.deliveryEnvelopeMs);
+  const budget = Number(diagnostics.decisionBudgetMs);
+  if (!Number.isFinite(envelope) || !Number.isFinite(budget)) return;
+  const target = Math.min(Math.max(plan.decisionWaitMs, envelope), budget);
+  if (!Number.isFinite(target) || target === Number(diagnostics.waitMs)) return;
+  await samplerClient.configure({ ...plan, decisionWaitMs: target });
+  await samplerClient.scenario(snapshot.scenarioId);
+  await refresh();
+}
