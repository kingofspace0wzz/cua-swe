diff --git a/src/config/compilePolicyPlan.js b/src/config/compilePolicyPlan.js
index 2a7047203072cbf1dea505637b50f5c6cb5121cd..7a98f8dd18aa2140ea96a207a358c34c8c0874b3 100644
--- a/src/config/compilePolicyPlan.js
+++ b/src/config/compilePolicyPlan.js
@@ -11,9 +11,32 @@ function compilePolicy(policy) {
   }
 }
 
-export function compilePolicyPlan(collector) {
+function compileDecisionWait(collector, receiver) {
+  if (collector.decisionWaitMs !== "receiver-delivery-frontier") {
+    return Number(collector.decisionWaitMs);
+  }
+
+  const deliveries = receiver?.deliveries;
+  if (!Array.isArray(deliveries) || deliveries.length === 0) {
+    throw new Error("Receiver delivery ledger is required to configure decision timing");
+  }
+
+  // Decisions are cached, so even a late failed dependency must be present at
+  // the first decision. Use the whole profile, not just the selected window.
+  // The smallest complete window avoids adding unnecessary decision latency.
+  return deliveries.reduce((waitMs, delivery) => {
+    const { firstSpanAtMs, lastSpanAtMs } = delivery;
+    if (!Number.isFinite(firstSpanAtMs) || !Number.isFinite(lastSpanAtMs)
+        || lastSpanAtMs < firstSpanAtMs) {
+      throw new Error("Receiver delivery ledger contains invalid receipt timing");
+    }
+    return Math.max(waitMs, lastSpanAtMs - firstSpanAtMs);
+  }, 0);
+}
+
+export function compilePolicyPlan(collector, receiver) {
   return {
-    decisionWaitMs: Number(collector.decisionWaitMs),
+    decisionWaitMs: compileDecisionWait(collector, receiver),
     policies: collector.policies.map(compilePolicy),
   };
 }
