-export function compilePolicyPlan(collector) {
+// Receiver operations runbook RB-217 delivery envelopes.
+const RUNBOOK_RB217_TABLE = {
+  "DP-C41": { deliveryEnvelopeMs: 2680, decisionMarginMs: 140 },
+  "DP-H77": { deliveryEnvelopeMs: 3560, decisionMarginMs: 140 },
+  "DP-K58": { deliveryEnvelopeMs: 3080, decisionMarginMs: 140 },
+};
+
+function decisionWaitMs(collector, receiver) {
+  const profile = receiver && receiver.firmware
+    ? RUNBOOK_RB217_TABLE[receiver.firmware.profileCode]
+    : null;
+  if (!profile) return Number(collector.decisionWaitMs);
+  return profile.deliveryEnvelopeMs + profile.decisionMarginMs;
+}
+
+export function compilePolicyPlan(collector, receiver) {
   return {
-    decisionWaitMs: Number(collector.decisionWaitMs),
+    decisionWaitMs: decisionWaitMs(collector, receiver),
     policies: collector.policies.map(compilePolicy),
   };
 }
