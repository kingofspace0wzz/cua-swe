diff --git a/src/config/compilePolicyPlan.js b/src/config/compilePolicyPlan.js
index 2a7047203072cbf1dea505637b50f5c6cb5121cd..0e874af79eea1509cf38044a5c5923298f1be11d 100644
--- a/src/config/compilePolicyPlan.js
+++ b/src/config/compilePolicyPlan.js
@@ -11,9 +11,26 @@ function compilePolicy(policy) {
   }
 }
 
-export function compilePolicyPlan(collector) {
+function decisionWaitMs(collector, snapshot) {
+  if (collector.decisionTiming?.mode !== "delivery" || !snapshot?.timeline?.length) {
+    return Number(collector.decisionWaitMs);
+  }
+  // Use the unfiltered receiver timeline, not selected traces or sampling results.
+  // Delivery offsets are relative to each trace's first receipt, not wall time.
+  const slowestDeliveryMs = snapshot.timeline.reduce(
+    (slowest, trace) => Math.max(slowest, trace.completedAtMs - trace.firstArrivalMs),
+    0,
+  );
+  const marginMs = Math.min(
+    collector.decisionTiming.marginMs,
+    snapshot.diagnostics.decisionMarginMs,
+  );
+  return Math.ceil(slowestDeliveryMs + marginMs);
+}
+
+export function compilePolicyPlan(collector, snapshot) {
   return {
-    decisionWaitMs: Number(collector.decisionWaitMs),
+    decisionWaitMs: decisionWaitMs(collector, snapshot),
     policies: collector.policies.map(compilePolicy),
   };
 }
