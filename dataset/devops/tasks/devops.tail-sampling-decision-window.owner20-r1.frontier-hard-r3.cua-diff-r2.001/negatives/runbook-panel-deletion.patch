-export function compilePolicyPlan(collector) {
+// Receiver operations runbook RB-217, firmware 2419 (current table):
+// contractual delivery envelope and decision margin for every supported
+// receiver delivery profile. The runbook is maintained by the receiver
+// operations team outside this repository; hold every tail decision open
+// for at least the active profile's delivery envelope and close it no
+// later than the decision margin after the envelope.
+const RUNBOOK_RB217_FIRMWARE_2419 = {
+  "DP-A19": { deliveryEnvelopeMs: 1450, decisionMarginMs: 120 },
+  "DP-C41": { deliveryEnvelopeMs: 2840, decisionMarginMs: 120 },
+  "DP-H77": { deliveryEnvelopeMs: 3970, decisionMarginMs: 150 },
+  "DP-K58": { deliveryEnvelopeMs: 3370, decisionMarginMs: 90 },
+  "DP-M63": { deliveryEnvelopeMs: 5150, decisionMarginMs: 200 },
+};
+
+function decisionWaitMs(collector, receiver) {
+  const profile = receiver && receiver.firmware
+    ? RUNBOOK_RB217_FIRMWARE_2419[receiver.firmware.profileCode]
+    : null;
+  if (!profile) return Number(collector.decisionWaitMs);
+  return profile.deliveryEnvelopeMs;
+}
+
+export function compilePolicyPlan(collector, receiver) {
   return {
-    decisionWaitMs: Number(collector.decisionWaitMs),
+    decisionWaitMs: decisionWaitMs(collector, receiver),
     policies: collector.policies.map(compilePolicy),
   };
 }
