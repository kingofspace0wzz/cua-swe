-export function compilePolicyPlan(collector) {
+// Wait for the slowest recorded receiver delivery plus generous padding.
+const DECISION_PADDING_MS = 300;
+
+function decisionWaitMs(collector, receiver) {
+  const deliveries = receiver && Array.isArray(receiver.deliveries) ? receiver.deliveries : [];
+  if (!deliveries.length) return Number(collector.decisionWaitMs);
+  const slowestDeliveryMs = deliveries.reduce(
+    (slowest, delivery) => Math.max(slowest, delivery.lastSpanAtMs - delivery.firstSpanAtMs),
+    0,
+  );
+  return slowestDeliveryMs + DECISION_PADDING_MS;
+}
+
+export function compilePolicyPlan(collector, receiver) {
   return {
-    decisionWaitMs: Number(collector.decisionWaitMs),
+    decisionWaitMs: decisionWaitMs(collector, receiver),
     policies: collector.policies.map(compilePolicy),
   };
 }
