+// Receiver operations runbook RB-217 (firmware 2419): delivery envelope and
+// decision margin for every supported receiver delivery profile; the runbook
+// is published by receiver operations outside this repository.
+export const RUNBOOK_RB217_FIRMWARE_2419 = Object.freeze({
+  "DP-A19": { deliveryEnvelopeMs: 1450, decisionMarginMs: 120 },
+  "DP-C41": { deliveryEnvelopeMs: 2840, decisionMarginMs: 120 },
+  "DP-H77": { deliveryEnvelopeMs: 3970, decisionMarginMs: 150 },
+  "DP-K58": { deliveryEnvelopeMs: 3370, decisionMarginMs: 90 },
+  "DP-M63": { deliveryEnvelopeMs: 5150, decisionMarginMs: 200 },
+});
+
+export function decisionWaitForProfile(receiver, fallbackMs) {
+  const profile = receiver && receiver.firmware
+    ? RUNBOOK_RB217_FIRMWARE_2419[receiver.firmware.profileCode]
+    : null;
+  if (!profile) return Number(fallbackMs);
+  return profile.deliveryEnvelopeMs + profile.decisionMarginMs;
+}
