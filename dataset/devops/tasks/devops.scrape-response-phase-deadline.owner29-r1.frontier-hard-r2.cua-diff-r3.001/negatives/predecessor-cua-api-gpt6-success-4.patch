diff --git a/src/budgets.mjs b/src/budgets.mjs
index f94b8c1680230d1aabcf6c4186b71868c30bf237..ec6d6a221fd458724c78670e0427bb423038ba0a 100644
--- a/src/budgets.mjs
+++ b/src/budgets.mjs
@@ -1,3 +1,27 @@
-// Staging scrape service objectives. Units are milliseconds.
+// Transport defaults for callers without a rollout-specific objective (milliseconds).
 export const budgets = Object.freeze({connectTimeoutMs:250, requestTimeoutMs:2000});
 export const serviceObjectives = Object.freeze({supportedResponseMs:1500, cancelByMs:2250, freshByMs:2500});
+
+// Receiver operations runbook: approved whole-response caps. A tier alone is
+// insufficient: each profile/tier/receiver-class combination has its own bound.
+const responseCaps = new Map([
+ ['RH-27', new Map([
+  ['standard', new Map([['interlock',1850], ['streamline',1350]])],
+  ['bulk', new Map([['interlock',2850], ['streamline',2150]])],
+ ])],
+ ['VT-58', new Map([
+  ['express', new Map([['relay',950], ['trunk',1650]])],
+  ['freight', new Map([['relay',2550], ['trunk',2150]])],
+ ])],
+ ['JN-84', new Map([
+  ['rapid', new Map([['orbit',1550], ['depot',1050]])],
+  ['batch', new Map([['orbit',2050], ['depot',2700]])],
+ ])],
+]);
+
+export function budgetsForTarget(target){
+ const requestTimeoutMs=responseCaps.get(target.profileCode)?.get(target.tier)?.get(target.receiverClass);
+ // Do not silently apply an unrelated rollout's deadline to an unknown target.
+ if(requestTimeoutMs===undefined)throw new Error('unknown_collection_objective');
+ return {...budgets,requestTimeoutMs};
+}
