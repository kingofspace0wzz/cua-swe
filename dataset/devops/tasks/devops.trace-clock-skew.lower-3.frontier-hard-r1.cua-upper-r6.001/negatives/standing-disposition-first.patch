--- a/src/trace/calibrationReference.js
+++ b/src/trace/calibrationReference.js
@@ -0,0 +1,39 @@
+function spanKey(span) {
+  return [span.service, span.operation, span.host].join("\u0000");
+}
+
+function authorityOf(span) {
+  return span.timeAuthority || span.host;
+}
+
+export async function findCalibrationReference(catalog, trace, loadTrace) {
+  const entry = (catalog.traces || []).find((item) => item.id === trace.id);
+  if (!entry?.capture || entry.capture.register !== "R-207") return null;
+  const references = (catalog.traces || []).filter(
+    (item) =>
+      item.capture?.register === "R-311" &&
+      item.capture.workload === entry.capture.workload &&
+      item.capture.disposition === "D-41",
+  );
+  return references.length ? loadTrace(references[0].id) : null;
+}
+
+export function alignToCalibrationReference(reference, { maxAdjustmentMs }) {
+  return function adjust(spans) {
+    const replayed = new Map(reference.spans.map((span) => [spanKey(span), span]));
+    const deltas = new Map();
+    for (const span of spans) {
+      const match = replayed.get(spanKey(span));
+      if (!match || match.durationMs !== span.durationMs) return spans;
+      const delta = match.startMs - span.startMs;
+      const authority = authorityOf(span);
+      if (!deltas.has(authority)) deltas.set(authority, delta);
+      else if (deltas.get(authority) !== delta) return spans;
+    }
+    return spans.map((span) => {
+      const delta = deltas.get(authorityOf(span)) || 0;
+      if (!delta || Math.abs(delta) > maxAdjustmentMs) return span;
+      return { ...span, startMs: span.startMs + delta, endMs: span.endMs + delta };
+    });
+  };
+}
