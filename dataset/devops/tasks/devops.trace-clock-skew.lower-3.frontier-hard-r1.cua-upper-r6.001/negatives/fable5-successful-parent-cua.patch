+export function compileAdjusters(policy, skewAdjuster = null) {
+  const adjusters = [{ name: "dedupe", apply: dedupeSpans }];
+  if (skewAdjuster) adjusters.push(skewAdjuster);
+  adjusters.push({ name: "sort", apply: sortSpans });
+  return adjusters;
 }

diff --git a/src/trace/skewAdjuster.js b/src/trace/skewAdjuster.js
new file mode 100644
index 0000000000000000000000000000000000000000..0a49d7fc1229581e047cd7df92e4af872abdc46c
--- /dev/null
+++ b/src/trace/skewAdjuster.js
@@ -0,0 +1,40 @@
+function matchKey(span) {
+  return `${span.service}|${span.operation}|${span.host}`;
+}
+
+export function selectTimingReference(catalog, capture) {
+  if (!capture || capture.window !== "before-reset") return null;
+  const owner = catalog.resetEvent?.owner;
+  return (
+    catalog.traces.find((entry) =>
+      entry.capture &&
+      entry.capture.workload === capture.workload &&
+      entry.capture.window === "after-reset" &&
+      entry.capture.status === "current" &&
+      entry.capture.recordedBy === owner,
+    ) || null
+  );
+}
+
+export function createSkewAdjuster(referenceSpans, policy) {
+  const reference = new Map(referenceSpans.map((span) => [matchKey(span), span]));
+  return {
+    name: "clock-skew",
+    apply(spans) {
+      const shifts = new Map();
+      for (const span of spans) {
+        const match = reference.get(matchKey(span));
+        if (!match) continue;
+        const difference = match.startMs - span.startMs;
+        if (!shifts.has(span.timeAuthority)) shifts.set(span.timeAuthority, difference);
+        else if (shifts.get(span.timeAuthority) !== difference) shifts.set(span.timeAuthority, null);
+      }
+      return spans.map((span) => {
+        if (span.parentId === null) return span;
+        const shift = shifts.get(span.timeAuthority);
+        if (!shift || Math.abs(shift) > policy.maxAdjustmentMs) return span;
+        return { ...span, startMs: span.startMs + shift, endMs: span.endMs + shift };
+      });
+    },
+  };
+}
