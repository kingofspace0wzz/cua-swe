diff --git a/src/trace/clockSkew.js b/src/trace/clockSkew.js
new file mode 100644
index 0000000000000000000000000000000000000000..b76883cf64ca6ea83c50650fafdcbbc13640977b
--- /dev/null
+++ b/src/trace/clockSkew.js
@@ -0,0 +1,52 @@
+// A clock correction is a translation of an entire time authority, never a
+// change to a host-measured duration or a repair of same-clock instrumentation.
+export function adjustClockSkew(spans, policy) {
+  const authority = (span) => policy.hostAuthorities?.get(span.host) ?? span.host;
+  const byId = new Map(spans.map((span) => [span.id, span]));
+  const groups = new Map();
+  for (const span of spans) {
+    const key = authority(span);
+    if (!groups.has(key)) groups.set(key, { edges: [], fixed: false });
+    const group = groups.get(key);
+    const parent = byId.get(span.parentId);
+    if (!parent) group.fixed = true;
+    else if (authority(parent) !== key) group.edges.push({ span, parent });
+  }
+
+  const shifts = new Map();
+  const visiting = new Set();
+  const limit = Math.max(0, policy.maxAdjustmentMs ?? 0);
+  function resolve(key) {
+    if (shifts.has(key)) return shifts.get(key);
+    // Cyclic authority dependencies cannot establish a reliable reference.
+    if (visiting.has(key)) return null;
+    const group = groups.get(key);
+    if (group.fixed) {
+      shifts.set(key, 0);
+      return 0;
+    }
+    visiting.add(key);
+    let lower = -limit;
+    let upper = limit;
+    let reliable = true;
+    for (const { span, parent } of group.edges) {
+      const parentShift = resolve(authority(parent));
+      if (parentShift === null) reliable = false;
+      else {
+        lower = Math.max(lower, parent.startMs + parentShift - span.startMs);
+        upper = Math.min(upper, parent.endMs + parentShift - span.endMs);
+      }
+    }
+    // Use the smallest bounded correction satisfying all incoming boundaries.
+    // If no translation can fit, retain the reported instrumentation instead.
+    const shift = !reliable ? null : lower <= upper ? Math.max(lower, Math.min(0, upper)) : 0;
+    visiting.delete(key);
+    shifts.set(key, shift);
+    return shift;
+  }
+  for (const key of groups.keys()) resolve(key);
+  return spans.map((span) => {
+    const shift = shifts.get(authority(span));
+    return shift ? { ...span, startMs: span.startMs + shift, endMs: span.endMs + shift } : span;
+  });
+}
