diff --git a/src/trace/skewAdjusters.js b/src/trace/skewAdjusters.js
new file mode 100644
index 0000000000000000000000000000000000000000..156acbc0900cd2dd94540d1a226d8e877b3a83f3
--- /dev/null
+++ b/src/trace/skewAdjusters.js
@@ -0,0 +1,69 @@
+const AUTHORITY_PATTERN = /time authority\s+([\w.-]+)/i;
+
+function authorityMap(trace) {
+  const authorities = new Map();
+  for (const entry of trace?.hostNotes || []) {
+    const declared = entry.authority || (AUTHORITY_PATTERN.exec(entry.note || "") || [])[1];
+    if (entry.host && declared) authorities.set(entry.host, declared);
+  }
+  return (host) => authorities.get(host) || host;
+}
+
+function depthOf(span, byId) {
+  let current = span;
+  let depth = 0;
+  const seen = new Set();
+  while (current && current.parentId !== null && !seen.has(current.id)) {
+    seen.add(current.id);
+    current = byId.get(current.parentId);
+    depth += 1;
+  }
+  return depth;
+}
+
+// Translate whole time-authority groups so remote spans fit inside the span
+// that caused them, without ever resizing a span:
+//  - boundaries are processed parent -> child, outer edge first, and nested
+//    edges compare against the parent's already displayed (shifted) range;
+//  - hosts under one time authority share one clock, so they share one offset;
+//  - the root's authority group and already-aligned groups stay fixed, which
+//    also leaves shared-authority instrumentation defects reported as-is.
+export function createClockAlignAdjuster(trace, policy) {
+  const maxAdjustmentMs = Number(policy?.maxAdjustmentMs);
+  return {
+    name: "align-clocks",
+    apply(spans) {
+      const authorityOf = authorityMap(trace);
+      const byId = new Map(spans.map((span) => [span.id, span]));
+      const offsets = new Map();
+      for (const span of spans) {
+        if (span.parentId === null) offsets.set(authorityOf(span.host), 0);
+      }
+      const boundaries = spans
+        .filter((span) => {
+          if (span.parentId === null) return false;
+          const parent = byId.get(span.parentId);
+          return Boolean(parent) && authorityOf(parent.host) !== authorityOf(span.host);
+        })
+        .map((span) => ({ span, parent: byId.get(span.parentId), depth: depthOf(span, byId) }))
+        .sort((left, right) => left.depth - right.depth);
+      for (const { span, parent } of boundaries) {
+        const group = authorityOf(span.host);
+        if (offsets.has(group)) continue;
+        const parentOffset = offsets.get(authorityOf(parent.host)) ?? 0;
+        const parentStart = parent.startMs + parentOffset;
+        const parentEnd = parent.endMs + parentOffset;
+        let shift = 0;
+        if (span.startMs < parentStart) shift = parentStart - span.startMs;
+        else if (span.endMs > parentEnd) shift = parentEnd - span.endMs;
+        if (Number.isFinite(maxAdjustmentMs) && Math.abs(shift) > maxAdjustmentMs) shift = 0;
+        offsets.set(group, shift);
+      }
+      return spans.map((span) => {
+        const shift = offsets.get(authorityOf(span.host)) || 0;
+        if (!shift) return span;
+        return { ...span, startMs: span.startMs + shift, endMs: span.endMs + shift };
+      });
+    },
+  };
+}
