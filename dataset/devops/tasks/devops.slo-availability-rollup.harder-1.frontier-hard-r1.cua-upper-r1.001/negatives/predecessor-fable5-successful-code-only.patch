@@ -1,15 +1,26 @@
-function compileRollup(rollup) {
+const POOLED_HINT = /pool|event|weight|ratio|sum/i;
+
+function resolveReference(mode, reference) {
+  const items = Array.isArray(reference) ? reference : [];
+  return items.find((item) => item.mode === mode)
+    || items.find((item) => item.mode !== "mean_of_slices" && POOLED_HINT.test(String(item.mode)))
+    || items.find((item) => item.mode !== "mean_of_slices" && POOLED_HINT.test(`${item.label ?? ""} ${item.description ?? ""}`))
+    || null;
+}
+
+function compileRollup(rollup, reference) {
+  const resolved = resolveReference(rollup.mode, reference);
   return {
-    mode: "mean_of_slices",
-    weight: rollup.weight || null,
+    mode: resolved ? resolved.mode : rollup.mode,
+    weight: rollup.weight ?? (resolved ? resolved.weight ?? null : null),
     includeIds: rollup.includeIds || null,
     minimumTotal: rollup.minimumTotal || 0,
   };
 }
 
-export function compileSloPlan(definition) {
+export function compileSloPlan(definition, rollupReference) {
   return {
-    availability: compileRollup(definition.availability),
-    budget: compileRollup(definition.budget),
+    availability: compileRollup(definition.availability, rollupReference),
+    budget: compileRollup(definition.budget, rollupReference),
   };
 }
