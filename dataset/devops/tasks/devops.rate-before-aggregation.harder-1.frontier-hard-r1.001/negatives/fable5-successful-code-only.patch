diff --git a/src/config/queryPolicy.js b/src/config/queryPolicy.js
index 565382644e0ff1b1d49ac03de3d8cf7f56af4160..33c23af5f6b299e2ca0d61f4dd1392e5dac74fce 100644
--- a/src/config/queryPolicy.js
