diff --git a/src/config/queryPolicy.js b/src/config/queryPolicy.js
index 565382644e0ff1b1d49ac03de3d8cf7f56af4160..e1e0017de1b1f2468a2880c48cd3b8b225f7f2ee 100644
--- a/src/config/queryPolicy.js
+++ b/src/config/queryPolicy.js
@@ -1,9 +1,23 @@
 /** Durable binding to a deployed recording-rule definition.
- * The operator console lists the definitions deployed by the metrics service.
+ * Resolve against the same upstream stages shown in the definitions inspector,
+ * rather than relying on a display name to imply reset-safe counter ordering.
  */
-export function queryPolicy() {
+export function queryPolicy(catalog) {
+  const definition = catalog.definitions.find(({steps}) => {
+    // Stages execute in order; nested PromQL calls execute inside-out.
+    // Include upstream stages so rate(sum(counter)) cannot look reset-safe
+    // merely because the aggregation lives in a separate recording rule.
+    const operations = steps.flatMap((step) =>
+      [...step.matchAll(/\b(rate|sum|avg|min|max|count|group|stddev|stdvar|topk|bottomk|quantile)\s*(?:\(|(?:by|without)\s*\()/g)]
+        .map((match) => match[1]).reverse(),
+    );
+    return /^rate(?:,rate)*,sum(?:,sum)*$/.test(operations.join(","));
+  });
+  if (!definition) {
+    throw new Error("No deployed rate-before-aggregation definition is available");
+  }
   return {
-    pipeline: "traffic-window",
+    pipeline: definition.id,
     panelScope: "all",
     sampleFilter: "none",
   };
