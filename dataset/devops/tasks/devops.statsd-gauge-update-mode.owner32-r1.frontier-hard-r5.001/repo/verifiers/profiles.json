 "transport_forms": [
  "batched-valid-lines",
  "split-whole-lines"
 ],
 "announce_batches_are_atomic": true,
 "maximum_datagram_bytes": 512,
 "public_contract": {
  "scope": "Finite gauge values in native units. Announce batches (relay sync register first, unsigned restatement of every tracked gauge) carry authoritative current readings. Between announces the deployment's provisioned relay generation determines whether signed live lines are relative updates (pass-through relays) or sign-formatted absolute readings (folding relays); the active generation is evaluator-owned deployment state reconciled from the announce evidence each epoch. All accepted receipt events preserve identity, relay attribution and multiplicity. No exact patch/config whitelist.",
  "numeric_range": "-1000000 through +1000000; finite decimals; abs tolerance 1e-9 or rel tolerance 1e-9",
  "receipt_processing_bound_ms": 1000,
  "datagram_scope": "Every submitted UDP datagram contains complete ASCII metric lines; LF batching valid; announce batches never split. No cross-datagram reconstruction requirement.",
  "transport_reliability": "Controlled localhost fixture: one in-flight datagram, raw capture plus native receipt counter barrier, no application retries. UDP loss/reorder/duplication outside intended writer multiplicity makes fixture infrastructure-invalid; no exactly-once/order claim for UDP generally."
 },
 "controls": [
  "healthy unsigned absolute stream",
  "relay sync registers as unaffected unsigned counters",
  "positive/negative/signed-zero live lines",
  "ordinary unsigned rebase between announces",
  "opening and mid-stream announce batches per relay",
  "first signed value with implicit zero on a late identity",
  "interleaved relay attribution",
  "identical line repeated within batch and across separate datagrams",
  "empty/no-input state",
  "idle does not reset gauges",
  "reset deletes gauges only through declared operator reset",
  "replay yields same state/history in a fresh epoch",
  "read/reload does not inject traffic",
  "process restart starts fresh then replay"
 ],
 "proof_variants": [
  "reference-announce-reconciled",
  "baseline-absolute-overwrite",
  "correct-held-reconciler",
  "correct-ingress-normalize",
  "negative-sign-delta-everywhere",
  "negative-add-everything",
  "negative-positive-only-relative",
  "negative-numeric-sign",
  "negative-deduplicate-lines",
  "negative-global-state",
  "negative-clamp-to-zero",
  "negative-reset-per-datagram",
  "negative-rebase-as-reconciliation",
  "negative-invert-binding",
  "negative-tracked-only-delta",
  "negative-ignore-signed-updates",
  "negative-render-running-total"
 ],
 "candidate_materialization": false
}
