@@ -0,0 +1,37 @@
+// Site relay reconciliation. Every relay opens its session epoch, and follows
+// each internal rollover, with one atomic announce batch: the relay's own
+// sync register line first, then the authoritative current reading of every
+// gauge the relay tracks. Between announces, live-forwarded lines follow the
+// deployment's provisioned relay generation: pass-through relays forward
+// signed relative updates, while folding relays publish sign-formatted
+// absolute readings. The first announce restatement that resolves a
+// divergence between the two running interpretations binds the active
+// generation for the epoch; announces re-run every epoch, so bindings never
+// outlive a session.
+const near = (a, b) => Math.abs(a - b) <= 1e-9 + 1e-9 * Math.abs(b);
+export const isSignedToken = token => /^[+-]/.test(String(token ?? ''));
+export function isAnnounceBatch(receipt, measurements) {
+  return measurements.length > 1 && measurements[0].identity === receipt.source + '.sync';
+}
+export function createReconciler() {
+  let mode = null;
+  const paths = new Map();
+  const path = identity => paths.get(identity) ?? {sum: 0, last: 0};
+  return {
+    mode: () => mode,
+    observe(event) {
+      const current = path(event.identity);
+      if (event.announce) {
+        if (mode === null && !near(current.sum, current.last)) {
+          mode = near(event.parsedValue, current.sum) ? 'absolute-reading' : 'signed-delta';
+        }
+        paths.set(event.identity, {sum: event.parsedValue, last: event.parsedValue});
+      } else if (isSignedToken(event.token)) {
+        paths.set(event.identity, {sum: current.sum + event.parsedValue, last: event.parsedValue});
+      } else {
+        paths.set(event.identity, {sum: event.parsedValue, last: event.parsedValue});
+      }
+      return mode;
+    },
+  };
+}
