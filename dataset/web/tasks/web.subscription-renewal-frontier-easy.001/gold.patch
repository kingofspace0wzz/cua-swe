+function formatInZone(epochMs, timeZone, pattern) {
+  const parts = Object.fromEntries(new Intl.DateTimeFormat("en-CA", {
+    timeZone, year:"numeric", month:"2-digit", day:"2-digit",
+    hour:"2-digit", minute:"2-digit", hourCycle:"h23",
+  }).formatToParts(new Date(epochMs)).map((part)=>[part.type,part.value]));
+  return pattern
+    .replace("YYYY",parts.year).replace("MM",parts.month).replace("DD",parts.day)
+    .replace("HH",parts.hour).replace("mm",parts.minute);
+}
 
